# Checkout & shipping configuration (partial example — the app uses more
# env vars than listed here; these are the ones the shop checkout needs).
# No new env vars are required for shipping: prices come from built-in zone
# tables (lib/shipping.ts) keyed off the destination the buyer enters in the
# cart. Works the same on any host.

# Stripe (already required by the app)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# OPTIONAL: set a Shippo key to upgrade to live carrier rates (paid service).
# Without it the zone tables are used and Shippo is never called.
# SHIPPO_API_KEY=shippo_test_...

# Warehouse return addresses for printed shipping labels (and for live-rate
# origin if Shippo is enabled). Canadian orders ship from Vaughan, ON; US
# orders from Las Vegas, NV. Optional — labels warn if unset.
SHIP_FROM_CA_NAME=LearnHoops
SHIP_FROM_CA_LINE1=
SHIP_FROM_CA_CITY=Vaughan
SHIP_FROM_CA_STATE=ON
SHIP_FROM_CA_ZIP=
SHIP_FROM_US_NAME=LearnHoops
SHIP_FROM_US_LINE1=
SHIP_FROM_US_CITY=Las Vegas
SHIP_FROM_US_STATE=NV
SHIP_FROM_US_ZIP=

# --- Sign in with Google / Apple ---
# Until these are set the provider buttons still render but bounce back to
# /login?error=oauth_unavailable. Email + password is unaffected either way.
# Both consoles need this exact origin, so it must already be correct:
#   NEXT_PUBLIC_BASE_URL=https://www.learnhoops.com

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (type: Web application).
#   Authorized redirect URI: https://www.learnhoops.com/api/auth/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Apple Developer -> Certificates, Identifiers & Profiles.
# APPLE_SERVICES_ID is the Services ID used by the WEBSITE (not the app's bundle
# id), with "Sign in with Apple" enabled, the domain learnhoops.com verified and
# the return URL https://www.learnhoops.com/api/auth/oauth/apple/callback
APPLE_SERVICES_ID=
# Your 10-character developer Team ID.
APPLE_TEAM_ID=
# The Key ID of a "Sign in with Apple" key, and the contents of its .p8 file.
# Paste the whole file including the BEGIN/END lines; literal \n also works.
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# The iOS app's bundle id. Only override if it ever changes.
# APPLE_APP_BUNDLE_ID=com.learnhoops.app

# --- Cloudflare Turnstile (bot protection on signup forms) ---
# Free at any volume. Create a widget at
# https://dash.cloudflare.com  ->  Turnstile  ->  Add site
#   Domain:   learnhoops.com   (add localhost too for local testing)
#   Mode:     Managed
# Both keys must be set for the check to run. With them unset the forms render
# without a widget and the server skips verification, so deploying this code
# before configuring the keys changes nothing.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAAA...
