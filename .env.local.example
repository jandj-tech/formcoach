# Checkout & shipping configuration (partial example — the app uses more
# env vars than listed here; these are the ones the shop checkout needs).

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Publishable key is required by the embedded checkout iframe on /checkout.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Shipping prices come from built-in zone tables (lib/shipping.ts) keyed off
# the buyer's postal code / state — free, no accounts needed. Nothing below
# is required for checkout to work.

# OPTIONAL: set a Shippo key to upgrade to live carrier rates (paid service).
# Without it the zone tables are used and Shippo is never called.
# SHIPPO_API_KEY=shippo_test_...

# Warehouse return addresses for printed shipping labels (and for live-rate
# origin if Shippo is enabled). Canadian orders ship from Vaughan, ON; US
# orders from Las Vegas, NV.
SHIP_FROM_CA_NAME=LearnHoops
SHIP_FROM_CA_LINE1=
SHIP_FROM_CA_CITY=Vaughan
SHIP_FROM_CA_STATE=ON
SHIP_FROM_CA_ZIP=
SHIP_FROM_US_NAME=LearnHoops
SHIP_FROM_US_LINE1=
SHIP_FROM_US_CITY=Las Vegas
SHIP_FROM_US_STATE=NV
SHIP_FROM_US_ZIP=
