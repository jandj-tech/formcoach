# Checkout & shipping configuration (partial example — the app uses more
# env vars than listed here; these are the ones the shop checkout needs).

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Publishable key is required by the embedded checkout iframe on /checkout.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Shippo — live carrier rates (Canada Post + USPS). Use a shippo_test_ token
# in development. If unset or unreachable, checkout falls back to the flat
# zone table in lib/shipping.ts.
SHIPPO_API_KEY=shippo_test_...

# Warehouses. Canadian orders ship from Vaughan, ON; US orders from
# Las Vegas, NV. Used for rate quotes and the printed return label.
SHIP_FROM_CA_NAME=LearnHoops
SHIP_FROM_CA_LINE1=
SHIP_FROM_CA_CITY=Vaughan
SHIP_FROM_CA_STATE=ON
SHIP_FROM_CA_ZIP=
SHIP_FROM_US_NAME=LearnHoops
SHIP_FROM_US_LINE1=
SHIP_FROM_US_CITY=Las Vegas
SHIP_FROM_US_STATE=NV
SHIP_FROM_US_ZIP=
